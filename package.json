{
  "name": "intent-gateway",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "boundaries": "depcruise --config .dependency-cruiser.cjs scripts $(test -d src && echo src)",
    "licence-check": "node scripts/licence-check.ts",
    "public-safety": "node scripts/public-safety.ts --optional",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries && pnpm licence-check && pnpm public-safety"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
