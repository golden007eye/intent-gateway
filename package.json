{
  "name": "intent-gateway",
  "version": "0.1.0-preview.5",
  "description": "Self-hosted gateway that lets AI agents shop with a human approval on every purchase. Pre-alpha.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agentic-commerce",
    "privacy",
    "self-hosted"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/golden007eye/intent-gateway.git"
  },
  "homepage": "https://github.com/golden007eye/intent-gateway#readme",
  "bugs": {
    "url": "https://github.com/golden007eye/intent-gateway/issues"
  },
  "type": "module",
  "bin": {
    "intent": "dist/main.js",
    "intent-gateway": "dist/main.js"
  },
  "files": [
    "dist",
    "policies",
    "contract",
    "onboarding",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "node scripts/bundle.ts && node scripts/build-info.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "boundaries": "depcruise --config .dependency-cruiser.cjs scripts test $(test -d src && echo src)",
    "licence-check": "node scripts/licence-check.ts",
    "public-safety": "node scripts/public-safety.ts --optional",
    "release": "node scripts/release.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries && pnpm licence-check && pnpm public-safety"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/tuf": "5.0.0",
    "@sigstore/verify": "4.1.2",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "qrcode-generator": "2.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.9.1"
}
